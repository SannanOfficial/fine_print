# Sends the weekly Fine Print email. Started by fineprint-newsletter.timer.
#
# Install:
#   sudo cp deploy/fineprint-newsletter.service deploy/fineprint-newsletter.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fineprint-newsletter.timer
#
# Check:  systemctl list-timers fineprint-newsletter.timer
# Logs:   journalctl -u fineprint-newsletter.service
#
# Runs the release that ~/fine_print/current points to (see deploy/remote-deploy.sh),
# with Node 24 (Fedora's nodejs24 package: /usr/bin/node-24).

[Unit]
Description=Fine Print: send the weekly email of recorded changes
Wants=network-online.target
# The database lives on this server: start after it (but don't require it).
After=network-online.target mongod.service

[Service]
Type=oneshot
User=deployment
Group=deployment
WorkingDirectory=/home/deployment/fine_print/current
# Holds MONGODB_WRITE_URI, FINEPRINT_DATA_KEY, MAIL_FROM, SMTP_URL and
# FINEPRINT_SITE_URL. Only this service should be able to read it.
EnvironmentFile=/etc/fineprint/newsletter.env
ExecStart=/usr/bin/node-24 scripts/newsletter.ts
TimeoutStartSec=30min

# Sandboxing: it only needs the database and the mail server.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# Home directories are hidden, except this app's own folder, read-only.
ProtectHome=tmpfs
BindReadOnlyPaths=/home/deployment/fine_print
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=512M
