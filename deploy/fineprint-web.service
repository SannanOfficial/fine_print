# Runs the Fine Print website behind a reverse proxy (Caddy or nginx) on the same server.
#
# Install:
#   sudo cp deploy/fineprint-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fineprint-web.service
#
# Logs:   journalctl -u fineprint-web.service
#
# Runs the release that ~/fine_print/current points to, built by
# deploy/remote-deploy.sh, with Node 24 (Fedora's nodejs24: /usr/bin/node-24).
# nginx proxies fineprint.syedsannan.com to port 3005 (deploy/nginx/).

[Unit]
Description=Fine Print: website
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=deployment
Group=deployment
WorkingDirectory=/home/deployment/fine_print/current
# Holds MONGODB_SITE_URI, FINEPRINT_DATA_KEY, FINEPRINT_SITE_URL, MAIL_FROM, SMTP_URL, OPENAI_API_KEY and
# FINEPRINT_CONTACT_EMAIL. Only this service should be able to read it.
EnvironmentFile=/etc/fineprint/web.env
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
# Listens on the loopback address only (localhost; ::1 on this server): visitors
# reach it through nginx, the only thing allowed to say what their IP address is
# (see README, "Deploying"). "localhost" rather than 127.0.0.1: given an IP
# address, Next.js treats its own internal rewrites (the 404 page) as requests
# to another site and fails them.
ExecStart=/usr/bin/node-24 node_modules/next/dist/bin/next start -H localhost -p 3005
Restart=on-failure
RestartSec=5

# Sandboxing: the website needs the network and its own cache folder, nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
# Home directories are hidden, except this app's own folder (Next.js writes its cache there).
ProtectHome=tmpfs
BindPaths=/home/deployment/fine_print
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=1G

[Install]
WantedBy=multi-user.target
