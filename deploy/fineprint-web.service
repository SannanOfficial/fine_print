# Runs the Fine Print website behind a reverse proxy (Caddy or nginx) on the same server.
#
# Install:
#   sudo cp deploy/fineprint-web.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now fineprint-web.service
#
# Logs:   journalctl -u fineprint-web.service
#
# Build first (npm ci && npm run build) as the fineprint user. Adjust User,
# WorkingDirectory, EnvironmentFile and the node path to your server.

[Unit]
Description=Fine Print: website
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=fineprint
Group=fineprint
WorkingDirectory=/srv/fine_print
# Holds MONGODB_SITE_URI, FINEPRINT_DATA_KEY, FINEPRINT_SITE_URL, MAIL_FROM, SMTP_URL, OPENAI_API_KEY and
# FINEPRINT_CONTACT_EMAIL. Only this service should be able to read it.
EnvironmentFile=/etc/fineprint/web.env
Environment=NODE_ENV=production
# Listens on localhost only: visitors reach it through the proxy, which is the
# only thing allowed to say what their IP address is (see README, "Deploying").
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5

# Sandboxing: the website needs the network and its own cache folder, nothing else.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=-/srv/fine_print/.next/cache
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
MemoryMax=1G

[Install]
WantedBy=multi-user.target
