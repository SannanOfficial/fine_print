# Copy to .env.local and fill in. Never commit real credentials.

# ---- Website (next start) ----

# Database user for the website, with the fineprintSite role (see README.md):
# it can read everything, add versions and edit the platform list, submissions,
# summaries, subscribers and sessions. It can never change or delete a recorded version.
MONGODB_SITE_URI=mongodb://fineprint_site:CHANGE_ME@127.0.0.1:27017/fine_print?authSource=fine_print

# Encrypts private submissions. 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# Keep a copy somewhere safe: without it, stored submissions and newsletter
# addresses cannot be read. The newsletter job needs it too.
FINEPRINT_DATA_KEY=

# ---- Email (website: confirmation emails; npm run newsletter: the weekly email) ----

# Sender, on a domain you've set up SPF/DKIM for with your provider.
MAIL_FROM="Fine Print <updates@fineprint.syedsannan.com>"
# Any SMTP provider, e.g. smtps://USER:PASSWORD@smtp.postmarkapp.com:465
SMTP_URL=
# For local testing instead of SMTP_URL: emails are saved here as .eml files, nothing is sent.
MAIL_OUTBOX_DIR=

# ---- Crawler and scripts (npm run crawl / capture / summarize / admin / newsletter / db:setup) ----

# Read-write user (role: readWrite). Do not give this one to the website process.
MONGODB_WRITE_URI=mongodb://fineprint_crawler:CHANGE_ME@127.0.0.1:27017/fine_print?authSource=fine_print

# Writes a plain-language summary of each change. Leave empty to skip summaries.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.4-mini.
OPENAI_MODEL=
# Optional. How long the crawler waits before its confirming second fetch (default 90000 ms). Lower it for local testing.
FINEPRINT_CONFIRM_DELAY_MS=

# ---- Both ----

MONGODB_DB=fine_print

# Public address of the site. Used in the crawler's User-Agent and in links.
FINEPRINT_SITE_URL=https://fineprint.syedsannan.com
# Optional. Shown in the footer and on receipts, and the reply address of every email sent.
# Defaults to contact@syedsannan.com.
FINEPRINT_CONTACT_EMAIL=
# Only if more than one copy of the website runs at once: the same random 32-byte base64 key on all of them.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
