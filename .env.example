# Copy to .env.local and fill in. Never commit real credentials.

# ---- Website (next start) ----

# Database user for the website, with the fineprintSite role (see README.md):
# it can read everything but write only submissions, summaries, sessions and
# rate-limit counters. It can never change the recorded terms.
MONGODB_SITE_URI=mongodb://fineprint_site:CHANGE_ME@127.0.0.1:27017/fine_print?authSource=fine_print

# Encrypts private submissions. 32 random bytes, base64. Generate with:
#   openssl rand -base64 32
# Keep a copy somewhere safe: without it, stored submissions cannot be read.
FINEPRINT_DATA_KEY=

# ---- Crawler and scripts (npm run crawl / capture / summarize / admin / db:setup) ----

# Read-write user (role: readWrite). Do not give this one to the website process.
MONGODB_WRITE_URI=mongodb://fineprint_crawler:CHANGE_ME@127.0.0.1:27017/fine_print?authSource=fine_print

# Writes a plain-language summary of each change. Leave empty to skip summaries.
OPENAI_API_KEY=
# Optional. Defaults to gpt-5.4-mini.
OPENAI_MODEL=

# ---- Both ----

MONGODB_DB=fine_print

# Public address of the site. Used in the crawler's User-Agent and in links.
FINEPRINT_SITE_URL=https://fineprint.syedsannan.com
