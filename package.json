{
  "name": "fine_print",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "crawl": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/crawl.ts",
    "capture": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/capture.ts",
    "summarize": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/summarize.ts",
    "db:setup": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/setup-db.ts",
    "admin": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/admin.ts",
    "newsletter": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/newsletter.ts",
    "status": "node --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/status.ts",
    "test": "node --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "diff": "9.0.0",
    "mongodb": "7.7.0",
    "next": "16.4.2",
    "node-html-markdown": "2.0.0",
    "node-html-parser": "6.1.13",
    "nodemailer": "^10.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "robots-parser": "3.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  }
}
